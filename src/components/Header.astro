---
import { nav } from "../data/site";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="Kettering Building Company, home">
    <span>Kettering</span>
    <span>Building</span>
    <span>Company</span>
  </a>
  <input class="nav-toggle" type="checkbox" id="nav-toggle" />
  <label class="nav-button" for="nav-toggle">
    <span class="open-label">Menu</span>
    <span class="close-label">Close</span>
  </label>
  <nav aria-label="Primary">
    <ul class="nav-list">
      {
        nav.map((item) => {
          const current = item.href === "/" ? path === "/" : path === item.href || path.startsWith(`${item.href}/`);
          return (
            <li>
              <a href={item.href} aria-current={current ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>
<script>
  const toggle = document.querySelector<HTMLInputElement>("#nav-toggle");
  const links = document.querySelectorAll(".nav-list a");
  links.forEach((link) => {
    link.addEventListener("click", () => {
      if (toggle) toggle.checked = false;
    });
  });
  toggle?.addEventListener("change", () => {
    document.body.classList.toggle("nav-open", toggle.checked);
  });
</script>
