---
import { site } from "../data/site";
---

<section class="hero" aria-label="Introduction">
  <div class="hero-scene" aria-hidden="true">
    <svg viewBox="0 0 900 760" role="img">
      <title>Line drawing of a gable house at dusk. Not a photo of a job.</title>
      <g fill="none" stroke="#f4f0e7" stroke-width="1.4" opacity="0.85">
        <path d="M250 430 L450 250 L650 430" />
        <path d="M280 430 V640 H620 V430" />
        <path d="M450 250 V160" />
        <path d="M430 160 H470" />
        <rect x="330" y="470" width="90" height="170" />
        <rect x="490" y="490" width="80" height="60" />
        <rect x="490" y="570" width="80" height="60" />
        <path d="M180 640 H760" />
        <path d="M120 700 H820" stroke-dasharray="2 8" />
        <path d="M700 500 H820 V640 H700" />
        <path d="M700 500 L760 460 H820" />
      </g>
      <g fill="none" stroke="#d7b56a" stroke-width="1" opacity="0.7">
        <path d="M80 640 C 220 600, 360 690, 520 640" />
      </g>
    </svg>
  </div>
  <div class="hero-copy">
    <p class="kicker">Welcome to {site.name}</p>
    <div class="hero-line"></div>
    <h1>Home building, floors and paint.</h1>
    <div class="hero-line"></div>
    <p class="hero-meta">Kettering · NN15 5HZ · Google {site.rating} from {site.reviewCount} reviews</p>
  </div>
</section>
