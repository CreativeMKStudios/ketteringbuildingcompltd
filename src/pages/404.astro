---
import Base from "../layouts/Base.astro";
import { sitePath } from "../data/site";

const title = "Page not found | Kettering Building Company Ltd";
const description = "That page is not on this site.";
---

<Base title={title} description={description} noindex={true}>
  <header class="page-hero">
    <div class="wrap">
      <p class="kicker">404</p>
      <h1>This page is not here.</h1>
      <p class="lede">The link may be old. The main pages are still on the menu.</p>
      <div class="actions">
        <a class="btn" href={sitePath("/")}>Back to the home page</a>
        <a class="btn ghost" href={sitePath("/contact")}>Contact</a>
      </div>
    </div>
  </header>
</Base>
